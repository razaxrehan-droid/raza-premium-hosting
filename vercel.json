
{
  "version": 2,
  "builds": [
    {
      "src": "api/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/s/([^/]+)/(.*)",
      "dest": "/api/site?slug=$1&file=$2"
    },
    {
      "src": "/s/([^/]+)",
      "dest": "/api/site?slug=$1&file=index.html"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
