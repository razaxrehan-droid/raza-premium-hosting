
{
  "rewrites": [
    {
      "source": "/f/:id",
      "destination": "/api/file?id=:id"
    },
    {
      "source": "/s/:slug",
      "destination": "/api/site?slug=:slug&file=index.html"
    },
    {
      "source": "/s/:slug/:file*",
      "destination": "/api/site?slug=:slug&file=:file*"
    }
  ]
}

